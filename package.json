{
  "name": "tsuzuru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "dev": "bun scripts/prepare-disclosure.ts && bun --bun nuxt dev",
    "build": "bun scripts/prepare-disclosure.ts && bun --bun nuxt build",
    "generate": "bun scripts/prepare-disclosure.ts && bun --bun nuxt generate",
    "test": "bun test tests",
    "alternatives:generate": "bun scripts/generate-alternatives.ts",
    "alternatives:prompts": "bun scripts/generate-alternatives.ts --prompts",
    "spellings:generate": ".cache/spelling-tools/bin/python scripts/generate-spelling-variants.py",
    "spellings:check": ".cache/spelling-tools/bin/python scripts/generate-spelling-variants.py --check",
    "spellings:test": "python3 -m unittest discover -s tests -p test_spelling_generator.py",
    "romaji:generate": ".cache/spelling-tools/bin/python scripts/generate-romaji-boundaries.py",
    "romaji:check": ".cache/spelling-tools/bin/python scripts/generate-romaji-boundaries.py --check",
    "romaji:test": ".cache/spelling-tools/bin/python -m unittest discover -s tests -p test_romaji_generator.py",
    "levels:generate": ".cache/spelling-tools/bin/python scripts/generate-sentence-levels.py",
    "levels:check": ".cache/spelling-tools/bin/python scripts/generate-sentence-levels.py --check",
    "levels:test": ".cache/spelling-tools/bin/python -m unittest discover -s tests -p test_sentence_levels.py",
    "hints:generate": "python3 scripts/generate-hint-glossary.py",
    "hints:check": "python3 scripts/generate-hint-glossary.py --check",
    "hints:test": "python3 -m unittest discover -s tests -p test_hint_glossary.py",
    "preview": "bun --bun nuxt preview",
    "start": "bun .output/server/index.mjs",
    "postinstall": "bun --bun nuxt prepare && bun run hooks:install",
    "hooks:install": "bun scripts/install-hooks.ts",
    "lint": "bun --bun oxlint --deny-warnings .",
    "lint:fix": "bun --bun oxlint --fix .",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "typecheck": "bun --bun nuxt typecheck && bun --bun tsc --project tsconfig.scripts.json && bun --bun tsc --project tsconfig.tests.json",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "wink-lemmatizer": "3.0.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
